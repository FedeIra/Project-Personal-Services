{
  "name": "fedeira-ppi-services",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=18 <21"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier --loglevel warn --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "offline-db-init": "dotenv -e .env -- serverless dynamodb start --config serverless.offline.yml --stage dev",
    "offline-db-verify": "aws dynamodb list-tables --endpoint-url http://localhost:8000",
    "offline-db-migrate": "dotenv -e .env -- ts-node dynamodb-config.ts",
    "offline": "dotenv -e .env -- serverless offline --config serverless.offline.yml --stage dev",
    "nodemon": "nodemon --watch . --ext ts,js,json --exec \"npm run offline\"",
    "package": "serverless package",
    "predeploy": "npm run build && npm run typecheck && npm run lint",
    "deploy": "npm run build && serverless deploy",
    "insert-user": "ts-node common/scripts/insert-user.ts",
    "insert-accounts": "ts-node common/scripts/insert-accounts.ts"
  },
  "dependencies": {
    "@fastify/aws-lambda": "^6.1.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.9",
    "axios-retry": "^4.5.0",
    "bcryptjs": "^3.0.2",
    "fastify": "^5.5.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.147",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "dotenv": "^16.4.7",
    "dotenv-cli": "^10.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.2",
    "rimraf": "^6.0.1",
    "serverless": "^4.1.0",
    "serverless-dynamodb-local": "^0.2.40",
    "serverless-offline": "^14.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
