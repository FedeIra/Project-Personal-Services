{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Serverless Offline (npx)",
      "runtimeExecutable": "npx",
      "args": [
        "serverless",
        "offline",
        "--config",
        "serverless.offline.yml",
        "--stage",
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "env": {
        "IS_OFFLINE": "true"
      },
      "outFiles": ["${workspaceFolder}/dist/**/*.js"]
    }
  ]
}
