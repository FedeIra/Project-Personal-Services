{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Serverless Offline",
      "runtimeExecutable": "npx",
      "args": [
        "serverless",
        "offline",
        "--config",
        "serverless.offline.yml",
        "--stage",
        "dev"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "env": {
        "IS_OFFLINE": "true",
        "NODE_OPTIONS": "--inspect=0"
      },
      "skipFiles": ["<node_internals>/**"],
      "outFiles": [
        "${workspaceFolder}/**/*.ts",
        "${workspaceFolder}/dist/**/*.js"
      ]
    }
  ]
}
